# Copy to ci/.env (gitignored, mode 600) for running the ci/ scripts from a
# workstation. In GitHub Actions the same names come from the repository's
# secrets (PVE_API_URL, PVE_TOKEN_ID, PVE_TOKEN_SECRET, PVE_TLS_PIN) and
# variables (PVE_NODE), and this file is never read.
#
# The addresses below are documentation examples (192.0.2.0/24): replace them
# with your own. Never commit real values -- only this example is tracked.

# --- Proxmox API -------------------------------------------------------------
# The API answers on every host address; the CI bridge's .1 is the one both
# the controller VM and a routed workstation reach.
PVE_API_URL=https://172.31.0.1:8006
PVE_TOKEN_ID=ci@pve!ci
# Secret. ci/host/apply.sh writes it here when it creates the token.
PVE_TOKEN_SECRET=
# The API certificate's public-key pin (sha256//<base64>), which curl checks
# instead of trusting a CA. ci/host/apply.sh writes it here.
PVE_TLS_PIN=

# --- Proxmox layout ------------------------------------------------------------
# The node's name as Proxmox knows it (`hostname` on the host).
PVE_NODE=pve
PVE_STORAGE=local-zfs
PVE_IMPORT_STORAGE=local
PVE_BRIDGE=vmbr1
CI_POOL=ci
# First three octets of the CI bridge's /24, private to the host.
CI_NET=172.31.0
CI_DNS="1.1.1.1 9.9.9.9"

# --- Workstation only ------------------------------------------------------------
# A login on the Proxmox host with passwordless sudo, for host/apply.sh and
# host/controller.sh. The CI runner never uses it.
PVE_SSH=ci@192.0.2.10
# The Proxmox host's LAN address: the gateway for the route to $CI_NET.0/24.
PVE_LAN_IP=192.0.2.10
# Who may open connections from the LAN into the CI bridge (space separated).
CI_TRUSTED_SRC=192.0.2.20
# Optional: an ssh jump host, for a workstation that has no route to $CI_NET.
#CI_JUMP=
